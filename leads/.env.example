# Copy to .env (never commit .env). Real environment variables override this file.

# GoHighLevel — Settings > Private Integrations > Create new integration.
# Scopes: View/Edit Contacts, View/Edit Opportunities, View Custom Fields.
GHL_API_KEY=pit-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The string after /location/ in your GHL URL
GHL_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

# Two cold-calling pipelines, by the exact names shown in GHL > Opportunities > Pipelines
GHL_PIPELINE_A=Cold Calling - Noah
GHL_PIPELINE_B=Cold Calling - Luca
# Optional: stage name to drop new opportunities into (defaults to each pipeline's first stage)
GHL_PIPELINE_STAGE=
# How to split leads between A and B:
#   alternate = even split, mobiles shared fairly between both (good for two callers)
#   mobile    = A gets mobile numbers, B gets landlines
PIPELINE_SPLIT=alternate

# Companies House — free key from https://developer.company-information.service.gov.uk/
# (create an application, then a "REST" API key). Without it owner names are skipped.
COMPANIES_HOUSE_API_KEY=
